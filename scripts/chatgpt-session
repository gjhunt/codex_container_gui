#!/usr/bin/env bash
set -euo pipefail

# Private keyring inside the container.
# Nothing here talks to the host keyring.
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
    eval "$(gnome-keyring-daemon \
        --start \
        --components=secrets \
        2>/dev/null)" || true
fi

exec chatgpt "$@"